# =============================================
# Maa Bhaglamkhi Resort - Frontend Config
# Local Network Deployment
# =============================================

# Backend API URL
# For local development on same PC:
#   VITE_API_URL=http://localhost:5002/api
#
# For other PCs on your WiFi network, use the SERVER'S IP:
#   1. Open CMD on server PC
#   2. Type: ipconfig
#   3. Look for "IPv4 Address" under WiFi (e.g. 192.168.1.100)
#   4. Set VITE_API_URL=http://192.168.1.100:5002/api
#
# MUST include /api suffix!
VITE_API_URL=http://localhost:5002/api